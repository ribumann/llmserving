APP_NAME=Azure LLM Serving Demo Backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/llmserving
DATABASE_ECHO=false
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Expected `aud` claim for a managed-identity bearer token calling the internal
# orchestration callback API (contracts/api.md), e.g. an Entra ID app registration's
# Application ID URI. Leave unset for local/test runs - internal endpoints fail
# closed (503) rather than accept unauthenticated callers.
INTERNAL_API_AUDIENCE=
HF_TOKEN_PASSTHROUGH_HEADER=X-HuggingFace-Token
AUTH_ALLOWED_EMAIL_DOMAINS=example.com
AUTH_BYPASS_PATHS=/healthz,/openapi.json,/docs,/docs/oauth2-redirect,/redoc,/internal
# No insecure default (e.g. 0.0.0.0/0). Set these to your presenter/office network
# CIDR so provisioning requests that don't supply allowedSshSourceCidr/
# allowedApiSourceCidr in configurableInputs still get a locked-down network.
DEFAULT_ALLOWED_SSH_SOURCE_CIDR=
DEFAULT_ALLOWED_API_SOURCE_CIDR=
VLLM_IMAGE=vllm/vllm-openai:latest
LM_EVAL_PATH=lm_eval
LLMPERF_PATH=llmperf
ADAPTER_CONTRACT_VERSION=2026-08-19
